# ========================================
# iapi 独立 SUPIR Worker 配置示例
# ========================================
# 使用：复制为当前目录的 .env，填写模型挂载目录和随机 API Key。
# 注意：SUPIR 官方软件仅限非商业使用，部署前请确认所有模型与依赖许可。

# Docker Compose 宿主机模型目录；容器内统一挂载为 /models。
SUPIR_MODELS_DIR=./models

# HTTP 服务与鉴权；生产环境必须替换为足够长的随机令牌。
SUPIR_WORKER_HOST=0.0.0.0
SUPIR_WORKER_PORT=8010
SUPIR_WORKER_API_KEY=replace-with-a-long-random-token

# SUPIR 仓库、配置和权重在容器内的路径。
SUPIR_WORKER_REPO_PATH=/opt/SUPIR
SUPIR_WORKER_CONFIG_PATH=/opt/SUPIR/options/SUPIR_v0.yaml
SUPIR_WORKER_MODEL_SIGN=Q
SUPIR_WORKER_DEVICE=cuda:0
SUPIR_WORKER_PRELOAD=true
SUPIR_WORKER_AE_DTYPE=bf16
SUPIR_WORKER_DIFFUSION_DTYPE=fp16
SUPIR_WORKER_SDXL_CHECKPOINT=/models/sd_xl_base_1.0_0.9vae.safetensors
SUPIR_WORKER_SUPIR_Q_CHECKPOINT=/models/SUPIR-v0Q.ckpt
SUPIR_WORKER_SUPIR_F_CHECKPOINT=/models/SUPIR-v0F.ckpt

# 显存优化与推理参数。
SUPIR_WORKER_LOADING_HALF_PARAMS=true
SUPIR_WORKER_USE_TILE_VAE=true
SUPIR_WORKER_ENCODER_TILE_SIZE=512
SUPIR_WORKER_DECODER_TILE_SIZE=64
SUPIR_WORKER_EDM_STEPS=50
SUPIR_WORKER_SEED=1234
SUPIR_WORKER_MIN_SIZE=1024
SUPIR_WORKER_S_STAGE1=-1
SUPIR_WORKER_S_CHURN=5
SUPIR_WORKER_S_NOISE=1.01
SUPIR_WORKER_S_CFG=4.0
SUPIR_WORKER_S_STAGE2=1.0
SUPIR_WORKER_COLOR_FIX_TYPE=Wavelet
SUPIR_WORKER_MAX_PIXELS=16777216

# 未随请求传入提示词时使用以下默认提示词。
SUPIR_WORKER_POSITIVE_PROMPT=Cinematic, highly detailed, realistic photograph, natural texture, sharp focus, perfect without deformations.
SUPIR_WORKER_NEGATIVE_PROMPT=painting, illustration, cartoon, 3D render, blurry, low quality, watermark, jpeg artifacts, deformed, over-smooth
