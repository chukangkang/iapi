# ========================================
# iapi Worker 节点配置示例
# ========================================
# 用途：只消费 Redis 任务并执行 GPU 图片生成；不启动 HTTP API。
# 启动：python -m app.worker

# Worker 模式必须使用 worker + redis。
SERVICE_ROLE=worker
TASK_QUEUE_BACKEND=redis

# 多机部署建议每台 Worker 设置稳定名称，便于日志和任务表排查。
WORKER_NAME=gpu-node-01
IMAGE_WORKER_COUNT=1
IMAGE_QUEUE_MAXSIZE=100

# API 和所有 Worker 必须完全一致。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_NAME=iapi:image_tasks
REDIS_PROCESSING_QUEUE_NAME=iapi:image_tasks:processing
REDIS_BLOCK_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=30
REDIS_REQUEUE_STALE_ENABLED=true
REDIS_PROCESSING_TIMEOUT=900
REDIS_REQUEUE_INTERVAL=30
TASK_RUNNING_HEARTBEAT_INTERVAL=30

# API 和所有 Worker 必须连接同一个任务数据库。
TASK_DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=iapi
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=iapi
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10

# ========================================
# 模型与 GPU 推理配置
# ========================================
MODEL_NAME=qwen-image-2512
MODEL_PATH=
DEVICE=auto
TORCH_DTYPE=bfloat16
# 多卡时填写物理 GPU 序号，例如 2,3,4,5；程序内会映射为逻辑 cuda:0,1,2,3。
MODEL_GPU_IDS=2,3,4,5
MODEL_GPU_COUNT=4
# 可选。限制每张可见 GPU 的模型加载显存，例如 18GiB；留空则按显卡总显存/剩余显存自动计算。
MODEL_GPU_MEMORY_LIMIT=
ENABLE_CPU_OFFLOAD=false
CPU_OFFLOAD_MODE=model
ENABLE_VAE_TILING=true
ENABLE_VAE_SLICING=true
ENABLE_ATTENTION_SLICING=false
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TOKENIZERS_PARALLELISM=false
HF_TOKEN=replace-with-your-huggingface-token-if-required

NUM_INFERENCE_STEPS=8
DEFAULT_WIDTH=1328
DEFAULT_HEIGHT=1328
MAX_GENERATION_PIXELS=786432
RESPONSE_METADATA_ENABLED=true
DEFAULT_ENHANCE_MODE=qwen_image

# Qwen Image 2512
QWEN_IMAGE_MODEL_NAME=qwen-image-2512
QWEN_IMAGE_MODEL_PATH=Qwen/Qwen-Image-2512
QWEN_IMAGE_STEPS=50
QWEN_IMAGE_TRUE_CFG_SCALE=4.0
# 固定负面提示词；Worker 推理时会覆盖请求中的 negative_prompt。
QWEN_IMAGE_NEGATIVE_PROMPT=低分辨率，低画质，肢体畸形，手指畸形，画面过饱和，蜡像感，人脸无细节，过度光滑，画面具有AI感。构图混乱。文字模糊，扭曲。

# 正向提示词自动扩写配置，与 API 节点模板保持同步。
# 扩写在 API 入队前执行，纯 Worker 节点不会主动调用该接口，因此通常保持 false。
PROMPT_ENHANCER_ENABLED=false
# chat 请求 /v1/chat/completions；responses 请求 /v1/responses。
PROMPT_ENHANCER_API_TYPE=chat
PROMPT_ENHANCER_BASE_URL=http://qwen-text-server:8000/v1
PROMPT_ENHANCER_API_KEY=
PROMPT_ENHANCER_MODEL=qwen3.6-27b
PROMPT_ENHANCER_TIMEOUT=30
PROMPT_ENHANCER_TEMPERATURE=0.3
PROMPT_ENHANCER_MAX_TOKENS=1000
PROMPT_ENHANCER_FALLBACK_TO_ORIGINAL=true

# Qwen Image 2512 Turbo LoRA 2-Steps；开启后默认使用 2 步和 true_cfg_scale=1.0。
QWEN_IMAGE_TURBO_LORA_ENABLED=false
QWEN_IMAGE_TURBO_LORA_PATH=Wuli-art/Qwen-Image-2512-Turbo-LoRA-2-Steps
QWEN_IMAGE_TURBO_LORA_WEIGHT_NAME=Wuli-Qwen-Image-2512-Turbo-LoRA-2steps-V1.0-bf16.safetensors
QWEN_IMAGE_TURBO_LORA_SCALE=1.0
QWEN_IMAGE_TURBO_LORA_FUSE=true
QWEN_IMAGE_TURBO_STEPS=2
QWEN_IMAGE_TURBO_TRUE_CFG_SCALE=1.0
QWEN_IMAGE_TURBO_SCHEDULER_EXPONENTIAL_SHIFT_MU=0.9162907318741551
QWEN_IMAGE_TURBO_SCHEDULER_USE_DYNAMIC_SHIFTING=true
QWEN_IMAGE_TURBO_SCHEDULER_SHIFT_TERMINAL=0.7155

# Qwen Image Edit / Unblur Upscale
QWEN_EDIT_MODEL_PATH=Qwen/Qwen-Image-Edit-2511
QWEN_EDIT_PIPELINE_CLASS=DiffusionPipeline
QWEN_EDIT_STEPS=4
QWEN_EDIT_GUIDANCE_SCALE=1.0
QWEN_EDIT_TRUE_CFG_SCALE=2.0
QWEN_EDIT_STRENGTH=0.12
QWEN_EDIT_SCALE_TO_SIDE=longest
QWEN_EDIT_SCALE_TO_LENGTH=1280
QWEN_EDIT_ROUND_TO_MULTIPLE=16
QWEN_EDIT_INPUT_FIT_MODE=contain
QWEN_EDIT_BACKGROUND_COLOR=#000000
QWEN_EDIT_QUANTIZATION=none
# Qwen-Image-Edit-2511 在 24GB 单卡上容易 OOM；8bit/4bit 对该模型部分组件可能无效，建议按 MODEL_GPU_IDS 做多卡分片。
QWEN_EDIT_DEVICE_MAP=balanced
# true 时 Qwen Edit 使用 MODEL_GPU_COUNT/MODEL_GPU_IDS 多卡分片加载（已内置，始终生效）。
QWEN_EDIT_MULTI_GPU_ENABLED=true
QWEN_UNBLUR_UPSCALE_LORA_PATH=prithivMLmods/Qwen-Image-Edit-2511-Unblur-Upscale
QWEN_UNBLUR_UPSCALE_LORA_WEIGHT_NAME=Qwen-Image-Edit-Unblur-Upscale_20.safetensors
# 官方 LoRA 触发词。人物图建议保持简短，长提示词容易重绘肤色/质感。
QWEN_UNBLUR_UPSCALE_TRIGGER_PROMPT=unblur and upscale
QWEN_UNBLUR_UPSCALE_LORA_SCALE=0.15

# 像素锐化 / Real-ESRGAN
PIXEL_SHARPEN_ENABLED=true
PIXEL_SHARPEN_RADIUS=0.9
PIXEL_SHARPEN_PERCENT=80
PIXEL_SHARPEN_THRESHOLD=8
UPSCALE_FIT_MODE=contain
UPSCALE_FILL_COLOR=black
# Optional for enhance_mode=realesrgan, qwen_edit_realesrgan, qwen_unblur_upscale_realesrgan.
# Empty means project ./weights; you can also set a directory or a concrete .pth file.
REALESRGAN_MODEL_PATH=
REALESRGAN_MODEL_NAME=realesr-general-x4v3
REALESRGAN_MAX_PASSES=1
REALESRGAN_DENOISE_STRENGTH=0.10
REALESRGAN_OUTSCALE=0
REALESRGAN_TILE=512
REALESRGAN_TILE_PAD=10
REALESRGAN_PRE_PAD=0
REALESRGAN_FACE_ENHANCE=false
REALESRGAN_FACE_ENHANCE_WEIGHT=0.25
REALESRGAN_FP32=false
REALESRGAN_ALPHA_UPSAMPLER=realesrgan
# Optional. Uncomment to pin Real-ESRGAN to a GPU id, for example 0.
# REALESRGAN_GPU_ID=0

# ========================================
# 输出配置
# ========================================
# 拆分部署强烈建议配置 OSS；否则 API 节点需要能访问 Worker 的本地 outputs 文件。
OUTPUT_DIR=outputs
PUBLIC_BASE_URL=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_PUBLIC_BASE_URL=
OSS_OBJECT_PREFIX=images
OSS_RETENTION_DAYS=14

OSS_STS_ROLE_ARN=
OSS_STS_DURATION=3600
ALIYUN_REGION_ID=cn-hangzhou
