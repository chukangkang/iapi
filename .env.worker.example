# ========================================
# iapi Worker 节点配置示例
# ========================================
# 用途：只消费 Redis 任务并执行 GPU 图片生成；不启动 HTTP API。
# 启动：python -m app.worker

# Worker 模式必须使用 worker + redis。
SERVICE_ROLE=worker
TASK_QUEUE_BACKEND=redis
HOST=0.0.0.0
PORT=8000

# 多机部署建议每台 Worker 设置稳定名称，便于日志和任务表排查。
WORKER_NAME=qwen-4gpu-node
IMAGE_WORKER_COUNT=1
IMAGE_QUEUE_MAXSIZE=100

# API 和所有 Worker 必须完全一致。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_NAME=iapi:image_tasks
REDIS_PROCESSING_QUEUE_NAME=iapi:image_tasks:processing
REDIS_BLOCK_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=30
REDIS_REQUEUE_STALE_ENABLED=true
REDIS_PROCESSING_TIMEOUT=900
REDIS_REQUEUE_INTERVAL=30
TASK_RUNNING_HEARTBEAT_INTERVAL=30
TASK_PUBLIC_BASE_URL=

# API 和所有 Worker 必须连接同一个任务数据库。
TASK_DB_BACKEND=mysql
TASK_DB_PATH=data/image_tasks.sqlite3
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=iapi
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=iapi
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10

# ========================================
# 模型与 GPU 推理配置
# ========================================
MODEL_NAME=qwen-image-2512
MODEL_PATH=
DEVICE=auto
TORCH_DTYPE=bfloat16
# 多卡时填写物理 GPU 序号，例如 2,3,4,5；程序内会映射为逻辑 cuda:0,1,2,3。
MODEL_GPU_IDS=0,1,2,3
MODEL_GPU_COUNT=4
# 可选。限制每张可见 GPU 的模型加载显存，例如 18GiB；留空则按显卡总显存/剩余显存自动计算。
MODEL_GPU_MEMORY_LIMIT=
ENABLE_CPU_OFFLOAD=false
CPU_OFFLOAD_MODE=model
ENABLE_VAE_TILING=true
ENABLE_VAE_SLICING=true
ENABLE_ATTENTION_SLICING=false
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TOKENIZERS_PARALLELISM=false
HF_TOKEN=replace-with-your-huggingface-token-if-required

NUM_INFERENCE_STEPS=8
DEFAULT_WIDTH=1328
DEFAULT_HEIGHT=1328
MAX_GENERATION_PIXELS=786432
RESPONSE_METADATA_ENABLED=true
DEFAULT_ENHANCE_MODE=qwen_image

# Qwen Image 2512
QWEN_IMAGE_MODEL_NAME=qwen-image-2512
QWEN_IMAGE_MODEL_PATH=Qwen/Qwen-Image-2512
QWEN_IMAGE_STEPS=50
QWEN_IMAGE_TRUE_CFG_SCALE=4.0
# 固定负面提示词；Worker 推理时会覆盖请求中的 negative_prompt。
QWEN_IMAGE_NEGATIVE_PROMPT=低分辨率，低画质，肢体畸形，手指畸形，画面过饱和，蜡像感，人脸无细节，过度光滑，画面具有AI感。构图混乱。文字模糊，扭曲。

# 正向提示词自动扩写配置，与 API 节点模板保持同步。
# 扩写在 API 入队前执行，纯 Worker 节点不会主动调用；Qwen Edit/修复模式始终跳过扩写以保持工作流指令原文。
PROMPT_ENHANCER_ENABLED=false
# chat 请求 /v1/chat/completions；responses 请求 /v1/responses。
PROMPT_ENHANCER_API_TYPE=chat
PROMPT_ENHANCER_BASE_URL=http://qwen-text-server:8000/v1
PROMPT_ENHANCER_API_KEY=
PROMPT_ENHANCER_MODEL=qwen3.6-27b
PROMPT_ENHANCER_TIMEOUT=30
PROMPT_ENHANCER_TEMPERATURE=0.3
PROMPT_ENHANCER_MAX_TOKENS=1000
PROMPT_ENHANCER_FALLBACK_TO_ORIGINAL=true
# 该规则由 API 扩写阶段使用；配置为空时不指定默认人物地域。
PROMPT_ENHANCER_DEFAULT_PERSON_REGION=中国

# Qwen Image 2512 Turbo LoRA 2-Steps；开启后默认使用 2 步和 true_cfg_scale=1.0。
QWEN_IMAGE_TURBO_LORA_ENABLED=false
QWEN_IMAGE_TURBO_LORA_PATH=Wuli-art/Qwen-Image-2512-Turbo-LoRA-2-Steps
QWEN_IMAGE_TURBO_LORA_WEIGHT_NAME=Wuli-Qwen-Image-2512-Turbo-LoRA-2steps-V1.0-bf16.safetensors
QWEN_IMAGE_TURBO_LORA_SCALE=1.0
QWEN_IMAGE_TURBO_LORA_FUSE=true
QWEN_IMAGE_TURBO_STEPS=2
QWEN_IMAGE_TURBO_TRUE_CFG_SCALE=1.0
QWEN_IMAGE_TURBO_SCHEDULER_EXPONENTIAL_SHIFT_MU=0.9162907318741551
QWEN_IMAGE_TURBO_SCHEDULER_USE_DYNAMIC_SHIFTING=true
QWEN_IMAGE_TURBO_SCHEDULER_SHIFT_TERMINAL=0.7155

# Qwen Image Edit / Unblur Upscale
QWEN_EDIT_MODEL_PATH=Qwen/Qwen-Image-Edit-2511
QWEN_EDIT_PIPELINE_CLASS=DiffusionPipeline
QWEN_EDIT_STEPS=4
QWEN_EDIT_GUIDANCE_SCALE=1.0
QWEN_EDIT_TRUE_CFG_SCALE=1.0
# Qwen-Image-Edit-2511 pipeline 主要通过图像条件重绘；仅 pipeline 支持 strength 时才会传入。
QWEN_EDIT_STRENGTH=1.0
QWEN_EDIT_SCALE_TO_SIDE=longest
QWEN_EDIT_SCALE_TO_LENGTH=2048
QWEN_EDIT_ROUND_TO_MULTIPLE=16
QWEN_EDIT_INPUT_FIT_MODE=cover
QWEN_EDIT_BACKGROUND_COLOR=#000000
QWEN_EDIT_QUANTIZATION=none
# Qwen-Image-Edit-2511 在 24GB 单卡上容易 OOM；本部署使用 4×4090 分层加载。
QWEN_EDIT_DEVICE_MAP=balanced
# true 时 Qwen Edit 使用 MODEL_GPU_COUNT/MODEL_GPU_IDS 多卡分片加载。
QWEN_EDIT_MULTI_GPU_ENABLED=true
QWEN_EDIT_TRANSFORMER_SHARDING_ENABLED=true
# 对齐参考工作流的 4-step Lightning LoRA 与 AuraFlow shift≈3（Diffusers 中使用 log(3)）。
QWEN_EDIT_LIGHTNING_LORA_ENABLED=true
QWEN_EDIT_LIGHTNING_LORA_PATH=lightx2v/Qwen-Image-Edit-2511-Lightning
QWEN_EDIT_LIGHTNING_LORA_WEIGHT_NAME=Qwen-Image-Edit-2511-Lightning-4steps-V1.0-fp32.safetensors
QWEN_EDIT_LIGHTNING_LORA_SCALE=1.0
QWEN_EDIT_SCHEDULER_BASE_SHIFT=1.0986122886681098
QWEN_UNBLUR_UPSCALE_LORA_PATH=prithivMLmods/Qwen-Image-Edit-2511-Unblur-Upscale
QWEN_UNBLUR_UPSCALE_LORA_WEIGHT_NAME=Qwen-Image-Edit-Unblur-Upscale_20.safetensors
# 参考工作流不使用该 Unblur LoRA，默认关闭；需要更强重绘时可开启。
QWEN_UNBLUR_UPSCALE_LORA_ENABLED=false
# 固定低重绘提示词；仅恢复清晰度，约束人物身份、五官、构图和物体位置不变。
QWEN_UNBLUR_UPSCALE_TRIGGER_PROMPT=Unblur and upscale this image. Restore only missing high-frequency details and improve clarity. Strictly preserve the original identity, facial geometry, facial features, expression, skin tone, hairstyle, pose, body proportions, clothing, composition, camera angle, lighting, colors, background, text, and object positions. Do not add, remove, move, reshape, or redesign any subject or object.
QWEN_UNBLUR_UPSCALE_LORA_SCALE=0.15
# 使用全局相似变换，仅修正整图平移、等比缩放和轻微旋转，不局部拉扯五官。translation dense  similarity
QWEN_UNBLUR_UPSCALE_ALIGNMENT_ENABLED=true
QWEN_UNBLUR_UPSCALE_ALIGNMENT_MODE=similarity
QWEN_UNBLUR_UPSCALE_ALIGNMENT_MAX_SHIFT=32
QWEN_UNBLUR_UPSCALE_ALIGNMENT_MAX_SCALE_DELTA=0.05
QWEN_UNBLUR_UPSCALE_ALIGNMENT_MAX_ROTATION_DEGREES=2.0
QWEN_UNBLUR_UPSCALE_ALIGNMENT_MAX_SIDE=1024
QWEN_UNBLUR_UPSCALE_ALIGNMENT_FLOW_STRENGTH=1.0

# 像素锐化 / Real-ESRGAN
PIXEL_SHARPEN_ENABLED=true
PIXEL_SHARPEN_RADIUS=0.9
PIXEL_SHARPEN_PERCENT=80
PIXEL_SHARPEN_THRESHOLD=8
UPSCALE_FIT_MODE=cover
UPSCALE_FILL_COLOR=black
# Optional for enhance_mode=realesrgan, qwen_edit_realesrgan, qwen_unblur_upscale_realesrgan.
# Empty means project ./weights; you can also set a directory or a concrete .pth file.
REALESRGAN_MODEL_PATH=
REALESRGAN_MODEL_NAME=realesr-general-x4v3
REALESRGAN_MAX_PASSES=1
REALESRGAN_DENOISE_STRENGTH=0.10
REALESRGAN_OUTSCALE=0
REALESRGAN_TILE=512
REALESRGAN_TILE_PAD=10
REALESRGAN_PRE_PAD=0
REALESRGAN_FACE_ENHANCE=false
REALESRGAN_FACE_ENHANCE_WEIGHT=0.25
REALESRGAN_FP32=false
REALESRGAN_ALPHA_UPSAMPLER=realesrgan
# Optional. Uncomment to pin Real-ESRGAN to a GPU id, for example 0.
REALESRGAN_GPU_ID=

# ========================================
# 专业照片修复编排
# ========================================
# auto 根据模糊、噪声、JPEG 块效应和细节自动选择 preserve/balanced。
RESTORATION_DEFAULT_MODE=auto
# preserve 使用非 GAN 的 RealESRNet，最大限度保持人物、文字和构图。
RESTORATION_PRESERVE_REALESRGAN_MODEL_NAME=RealESRNet_x4plus
RESTORATION_BALANCED_REALESRGAN_MODEL_NAME=realesr-general-x4v3
RESTORATION_CREATIVE_REALESRGAN_MODEL_NAME=RealESRGAN_x4plus
# auto 模式轻量检测动漫/插画；命中后使用动漫专用模型，并跳过照片人脸恢复与照片 SwinIR。
RESTORATION_ANIME_DETECTION_ENABLED=true
RESTORATION_ANIME_SCORE_THRESHOLD=0.58
RESTORATION_ANIME_REALESRGAN_MODEL_NAME=RealESRGAN_x4plus_anime_6B

# SwinIR 降噪/JPEG 修复；balanced 模式在放大前自动按分析结果选择官方模型。
SWINIR_ENABLED=false
# 留空时使用 weights/SwinIR 并按需下载；也可指定模型目录或固定 .pth 权重。
SWINIR_MODEL_PATH=
SWINIR_AUTO_DOWNLOAD=true
SWINIR_TILE=512
SWINIR_TILE_OVERLAP=32
SWINIR_FP32=false
# 可选。指定逻辑 GPU，例如 0；留空时使用默认 CUDA 设备。
SWINIR_GPU_ID=

# 人脸恢复候选与身份校验；CodeFormer 只生成对齐人脸候选，评分/过滤完成前不会贴回原图。
CODEFORMER_ENABLED=false
CODEFORMER_MODEL_PATH=weights/CodeFormer/codeformer.pth
CODEFORMER_AUTO_DOWNLOAD=true
CODEFORMER_FIDELITY_WEIGHT=0.7
INSIGHTFACE_ENABLED=false
# buffalo_l 会由 InsightFace 自动下载到该根目录；优先 CUDAExecutionProvider，自动回退 CPU。
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_MODEL_ROOT=weights/insightface
# CodeFormer 候选与原始对齐人脸的 ArcFace 余弦相似度下限。
INSIGHTFACE_IDENTITY_THRESHOLD=0.65
# 五点关键点在消除平移、旋转和统一缩放后的归一化 RMS/最大残差阈值。
LANDMARK_DEFORMATION_RMS_THRESHOLD=0.08
LANDMARK_DEFORMATION_MAX_THRESHOLD=0.16
# 通过身份与关键点过滤的人脸，以椭圆羽化遮罩按原仿射矩阵贴回。
FACE_MASK_INSET_RATIO=0.12
FACE_MASK_BLUR_RATIO=0.08
FACE_MASK_OPACITY=0.90
# 最终综合分低于阈值时自动保留该位置的原始人脸。
FACE_CANDIDATE_MIN_SCORE=0.72
FACE_CANDIDATE_IDENTITY_WEIGHT=0.50
FACE_CANDIDATE_GEOMETRY_WEIGHT=0.30
FACE_CANDIDATE_QUALITY_WEIGHT=0.15
FACE_CANDIDATE_DETECTION_WEIGHT=0.05

# SUPIR 作为独立服务，仅 creative 模式可调用；失败会自动回退本地链路。
SUPIR_ENABLED=false
SUPIR_BASE_URL=http://supir-worker:8000
SUPIR_API_KEY=
SUPIR_TIMEOUT=900
SUPIR_ENDPOINT=/v1/restore

# ========================================
# 输出配置
# ========================================
# 拆分部署强烈建议配置 OSS；否则 API 节点需要能访问 Worker 的本地 outputs 文件。
OUTPUT_DIR=outputs
PUBLIC_BASE_URL=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_PUBLIC_BASE_URL=
OSS_OBJECT_PREFIX=images
OSS_RETENTION_DAYS=14

OSS_STS_ROLE_ARN=
OSS_STS_DURATION=3600
ALIYUN_REGION_ID=cn-hangzhou
